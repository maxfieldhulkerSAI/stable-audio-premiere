{
  "manifestVersion": 5,
  "id": "ai.stability.stableaudio.premiere",
  "name": "Stable Audio",
  "version": "0.3.0",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "25.6.0"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "stableAudioPanel",
      "label": {
        "default": "Stable Audio"
      },
      "minimumSize": { "width": 300, "height": 420 },
      "preferredDockedSize": { "width": 360, "height": 640 },
      "preferredFloatingSize": { "width": 380, "height": 640 },
      "maximumSize": { "width": 600, "height": 2000 }
    }
  ],
  "requiredPermissions": {
    "network": {
      "domains": [
        "https://api.stability.ai"
      ]
    },
    "localFileSystem": "fullAccess",
    "clipboard": "readAndWrite"
  }
}
